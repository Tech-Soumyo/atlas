# =============================================================================
# Atlas — environment template
# =============================================================================
# Copy to `.env` and fill secrets locally. NEVER commit `.env`.
# Do not leave real keys in comments either — rotate anything that was pasted here.
#
# Guides:
#   docs/zero_cost_showcase.md   — Groq / Gemini / Ollama
#   docs/upstash_integration.md  — optional serverless data plane
#   TECH_STACK.md                — stack overview
#   configs/*.yaml               — non-secret tunables (chunking, retrieval, …)
#
# Used by: apps/api, apps/worker (and Compose). Web vars also in apps/web/.env.local
# =============================================================================

# -----------------------------------------------------------------------------
# App / runtime
# -----------------------------------------------------------------------------
ATLAS_ENV=development
# local = Docker Redis + Qdrant | upstash = Upstash Redis + Vector + QStash
ATLAS_DATA_PLANE=local
ATLAS_LOG_LEVEL=INFO
ATLAS_API_HOST=0.0.0.0
ATLAS_API_PORT=8000

# -----------------------------------------------------------------------------
# Auth (demo JWT / API keys — replace for anything beyond local showcase)
# -----------------------------------------------------------------------------
ATLAS_JWT_SECRET=change-me-in-local-only
ATLAS_JWT_ALGORITHM=HS256
ATLAS_JWT_EXPIRE_MINUTES=1440
# Shared M1 API key for X-API-Key (required when ATLAS_ENV is not test)
ATLAS_API_KEY=dev-local-atlas-key
# Optional static demo keys: tenant_id:user_id:role1|role2
# ATLAS_DEMO_API_KEYS=demo-hr:user_hr:hr|admin,demo-eng:user_eng:eng

# M1 ingest / ask caps and rate limits
ATLAS_MAX_UPLOAD_BYTES=20971520
ATLAS_MAX_PDF_PAGES=50
ATLAS_MAX_DOCUMENTS=10
ATLAS_INGEST_STALE_SECONDS=900
ATLAS_RATE_LIMIT_UPLOAD_PER_MIN=5
ATLAS_RATE_LIMIT_ASK_PER_MIN=20

# -----------------------------------------------------------------------------
# PostgreSQL (documents, chunks, ACL, jobs, BM25/FTS, audit)
# -----------------------------------------------------------------------------
# Local Compose default:
DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
#
# Neon (recommended for ₹0 / hosted showcase):
#   - Use the SQLAlchemy + psycopg form with SSL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
# DATABASE_URL_POOLED=postgresql+psycopg://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require
#
# Compose-friendly discrete vars (optional if DATABASE_URL is set)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Neon Auth / AI Gateway (not required for M0 RAG)
# NEON_AUTH_BASE_URL=
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_TOKEN=

# -----------------------------------------------------------------------------
# Local data plane (ATLAS_DATA_PLANE=local)
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=atlas_chunks

REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=atlas:ingest
REDIS_CACHE_TTL_SECONDS=3600

# Raw uploads — local disk (Compose) or S3-compatible (Neon / MinIO)
OBJECT_STORE_BACKEND=local
OBJECT_STORE_PATH=./data/raw
#
# Neon Object Storage (S3-compatible). Names are AWS_* by SDK convention —
# these come from the Neon console, not from Amazon AWS.
# OBJECT_STORE_BACKEND=s3
# AWS_ENDPOINT_URL_S3=https://<neon-s3-endpoint>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# S3_BUCKET=
#
# Local MinIO alternative:
# OBJECT_STORE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=atlas
# S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Optional Upstash data plane (ATLAS_DATA_PLANE=upstash)
# See docs/upstash_integration.md
# Vector index: Custom dims=384, COSINE, Hybrid enabled (matches MiniLM)
# QStash needs a public worker URL in local dev (e.g. Cloudflare Tunnel)
# -----------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_REDIS_REST_READ_ONLY_TOKEN=
# UPSTASH_VECTOR_REST_URL=
# UPSTASH_VECTOR_REST_TOKEN=
# UPSTASH_VECTOR_REST_READ_ONLY_TOKEN=
# QSTASH_URL=https://qstash.upstash.io
# QSTASH_TOKEN=
# QSTASH_READ_ONLY_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# ATLAS_WORKER_PUBLIC_URL=https://xxxx.trycloudflare.com

# -----------------------------------------------------------------------------
# LLM generation (OpenAI-compatible adapter)
# The adapter always reads: LLM_BASE_URL + OPENAI_API_KEY + LLM_MODEL
# Provider-specific keys below are for clarity / switching; copy the active
# provider key into OPENAI_API_KEY.
# -----------------------------------------------------------------------------
# Provider keys (keep both; switch by changing LLM_* + OPENAI_API_KEY)
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Default ₹0 showcase: Groq free tier — https://console.groq.com ---
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
# Must equal GROQ_API_KEY when LLM_PROVIDER=groq
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# --- Backup: Gemini free tier (comment Groq LLM_* block, use this) ---
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=   # MUST equal GEMINI_API_KEY (not an OpenAI sk-… key)
# LLM_MODEL=gemini-2.0-flash

# --- Offline fallback: Ollama ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=llama3.2:3b

# -----------------------------------------------------------------------------
# Embeddings / rerank (keep LOCAL to protect free-tier LLM quotas)
# Align dims with configs/models.yaml and Upstash Vector index (384 + COSINE)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMS=384
EMBEDDING_MODEL_VERSION=st-all-minilm-l6-v2@1
EMBEDDING_DEVICE=cpu
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# -----------------------------------------------------------------------------
# Feature flags (override configs/feature_flags.yaml when set)
# -----------------------------------------------------------------------------
ENABLE_QUERY_REWRITE=true
ENABLE_MULTI_QUERY=false
ENABLE_MMR=false
ENABLE_XGB_RERANK=false
ENABLE_AGENTIC=false
ENABLE_SEMANTIC_CHUNKING=false
ENABLE_RESPONSE_CACHE=true

# -----------------------------------------------------------------------------
# Retrieval defaults (optional overrides; prefer configs/retrieval.yaml)
# -----------------------------------------------------------------------------
# DENSE_TOP_K=20
# SPARSE_TOP_K=20
# FUSED_TOP_K=30
# RERANK_TOP_K=8
# RRF_K=60
# ABSTAIN_MIN_RERANK_SCORE=0.15

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=atlas-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=none

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=3
WORKER_JOB_TIMEOUT_SECONDS=600
WORKER_HEARTBEAT_SECONDS=10
# Optional override for YAML directory (Compose sets /app/configs)
# ATLAS_CONFIGS_DIR=./configs

# -----------------------------------------------------------------------------
# Web (Next.js) — also copy public vars to apps/web/.env.local
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8000
# Server-only if you add a Next.js BFF later (do not prefix with NEXT_PUBLIC_)
# ATLAS_API_INTERNAL_URL=http://api:8000
